{
  "id": "codex",
  "version": "1.1.0",
  "name": "Codex",
  "description": "Configures a Dev Container for the Codex IDE extension, including its Linux sandbox and container-specific persistent storage.",
  "documentationURL": "https://github.com/novanmondon/codex-devcontainer-feature/tree/main/src/codex",
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "mounts": [
    {
      "source": "codex-home-${devcontainerId}",
      "target": "/var/lib/codex-home",
      "type": "volume"
    }
  ],
  "containerEnv": {
    "CODEX_HOME": "/var/lib/codex-home"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "wenbopan.vscode-terminal-osc-notifier"
      ]
    }
  }
}
