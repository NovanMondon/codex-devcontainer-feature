{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json",
  "id": "codex-secure",
  "version": "1.0.0",
  "name": "Codex secure environment",
  "description": "Installs Codex CLI and configures its nested Linux sandbox, restricted egress, WSL authentication sharing, and read-only shared skills.",
  "documentationURL": "https://github.com/novanmondon/codex-devcontainer-feature/tree/main/src/codex-secure",
  "options": {
    "codexVersion": {
      "type": "string",
      "proposals": [
        "0.121.0"
      ],
      "default": "0.121.0",
      "description": "Exact @openai/codex npm version to install."
    },
    "enableFirewall": {
      "type": "boolean",
      "default": true,
      "description": "Apply a default-deny IPv4/IPv6 egress firewall when the container starts."
    },
    "allowedDomains": {
      "type": "string",
      "default": "api.openai.com auth.openai.com github.com api.github.com codeload.github.com raw.githubusercontent.com objects.githubusercontent.com registry.npmjs.org",
      "description": "Space- or comma-separated domain names allowed through the runtime firewall."
    },
    "includeGitHubMetaRanges": {
      "type": "boolean",
      "default": true,
      "description": "Also allow IPv4 web, API, and Git ranges returned by api.github.com/meta."
    }
  },
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "init": true,
  "capAdd": [
    "SYS_ADMIN",
    "SYS_CHROOT",
    "SETUID",
    "SETGID",
    "SYS_PTRACE",
    "NET_ADMIN",
    "NET_RAW"
  ],
  "securityOpt": [
    "seccomp=unconfined",
    "apparmor=unconfined"
  ],
  "mounts": [
    "source=codex-home-${devcontainerId},target=/var/lib/codex-home,type=volume",
    "source=${localEnv:HOME}/.codex/auth.json,target=/var/lib/codex-home/auth.json,type=bind",
    "source=${localEnv:AGENTS_SKILLS_DIR:/mnt/d/codex/agents-skills},target=/etc/codex/skills,type=bind,readonly"
  ],
  "containerEnv": {
    "CODEX_HOME": "/var/lib/codex-home",
    "CODEX_UNSAFE_ALLOW_NO_SANDBOX": "1"
  },
  "entrypoint": "/usr/local/share/codex-secure/entrypoint.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ]
    }
  }
}
